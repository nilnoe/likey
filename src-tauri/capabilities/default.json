{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Likey 默认权限：核心 + 对话框 + 存储 + HTTP（全 https/http 域，供音源取流）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
